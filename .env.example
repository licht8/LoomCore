POSTGRES_USER=loomuser
POSTGRES_PASSWORD=change-this-to-a-long-random-password
POSTGRES_DB=loomcore
HETZNER_API_KEY=replace-with-hetzner-api-key
# LLM request timeouts (seconds) and retries on transport/timeout errors.
HETZNER_CONNECT_TIMEOUT=15
HETZNER_READ_TIMEOUT=300
HETZNER_WRITE_TIMEOUT=30
HETZNER_POOL_TIMEOUT=15
HETZNER_MAX_RETRIES=2
DEBUG=false
ADMIN_TOKEN=generate-a-long-random-admin-token
LOOMWG_SKIP_FIREWALL=0
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=generate-with-the-auth-helper
ADMIN_TOTP_SECRET=base32-secret
SESSION_SECRET=generate-a-long-random-session-secret
# Force the session cookie's Secure flag (also auto-set when the request
# arrives with X-Forwarded-Proto: https).
SECURE_COOKIES=false
# Persist revoked JWTs across restarts at this path (empty = in-memory only).
LOOMCORE_REVOKED_FILE=
# Reverse proxies whose X-Forwarded-For / X-Real-IP may be trusted for the real
# client IP (used by rate limiting). Comma/space separated CIDRs. Loopback by
# default (nginx runs on 127.0.0.1); set to the proxy address if different.
TRUSTED_PROXIES=127.0.0.1,::1
# --- LoomOps (deny-by-default) ---
# Allow-listed executable basenames for ops_run_command (empty = deny all).
LOOMOPS_ALLOWED_COMMANDS=
# Roots ops_read_file/ops_write_file may touch (empty = deny all).
LOOMOPS_ALLOWED_PATHS=
# JSON-lines audit log (empty = plugins/LoomOps/tmp/loomops-audit.log in-container).
LOOMOPS_AUDIT_LOG=
LOOMOPS_COMMAND_TIMEOUT=30
# --- LoomOps host observability (read-only; host paths mounted under /host) ---
LOOMOPS_LOG_ROOTS=/host/var/log
LOOMOPS_MAX_LOG_LINES=200
LOOMOPS_CPU_THRESHOLD=80
LOOMOPS_DISK_THRESHOLD=90
LOOMOPS_LOAD_THRESHOLD=2.0
# Plugin enable/disable state file (empty = <plugins_dir>/../.loomcore/plugins.json).
PLUGINS_STATE_FILE=
# Plugin trust boundary: comma/space-separated plugin ids allowed to launch
# (empty = launch every discovered plugin). Plugins run unsandboxed as root.
LOOMCORE_PLUGINS_ALLOWED=
