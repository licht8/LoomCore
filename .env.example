POSTGRES_USER=loomuser
# Required: a long random password. Compose refuses to start while this is empty.
POSTGRES_PASSWORD=
POSTGRES_DB=loomcore
# Optional: full SQLAlchemy URL. Compose derives it from POSTGRES_* above; set
# it only when running the core outside compose (default is credential-free).
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/loomcore
# Optional LLM bootstrap. Leave everything unset to pick a provider at runtime
# in the app's Settings tab; these only pre-seed the very first start.
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=
# Optional smaller/faster model for plan summaries; empty = main model.
# LLM_SUMMARY_MODEL=
# Max output tokens per call (bounds generation; raise if a plan/summary is
# truncated, e.g. when a reasoning model is used).
# LLM_PLANNER_MAX_TOKENS=1024
# LLM_SUMMARY_MAX_TOKENS=512
# LLM request timeouts (seconds) and retries on transport/timeout errors.
# LLM_CONNECT_TIMEOUT=15
# LLM_READ_TIMEOUT=30
# LLM_WRITE_TIMEOUT=30
# LLM_POOL_TIMEOUT=15
# LLM_MAX_RETRIES=1
# Send the provider's thinking template (default 0 = never sent).
# LLM_THINKING_TEMPLATE=0
# Whether the thinking template requests reasoning (only used with the above).
# LLM_ENABLE_THINKING=0
# Where the runtime provider config is persisted (empty = /data/llm.json).
# LLM_SETTINGS_FILE=
# Daily LLM call budget: 1000 = default guard; 0 = no guard (not recommended).
# Protects the provider balance from a compromised token; resets at UTC midnight.
# Budget counts LLM HTTP calls, not turns. Per turn: planner (1) + summary
# (1 for multi-step plans; direct single-step actions skip it), plus +1 per
# planner re-ask, plus +1 per transport retry.
LLM_DAILY_CALL_LIMIT=1000
DEBUG=false
# Admin auth mode: token | jwt | both | "" (auto). Auto prefers jwt when
# password+TOTP is configured, so a leftover ADMIN_TOKEN cannot bypass 2FA.
# Set both only if the static token must keep working alongside password+TOTP.
AUTH_MODE=
ADMIN_TOKEN=
LOOMWG_SKIP_FIREWALL=0
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=generate-with-the-auth-helper
ADMIN_TOTP_SECRET=base32-secret
SESSION_SECRET=generate-a-long-random-session-secret
# Mark the session cookie Secure. Leave true; set false only for plain-HTTP dev.
SECURE_COOKIES=true
# Refuse every admin auth path over non-TLS requests: password login, session
# cookie, Bearer static token and the WebSocket handshake all fail closed with
# 403. Requires the nginx TLS block; set false to defer (not recommended).
REQUIRE_TLS=true
# Persist revoked JWTs across restarts on the named volume (loomdata:/data).
# Empty = in-memory only, so logout does not survive a restart.
LOOMCORE_REVOKED_FILE=/data/revoked.json
# Reverse proxies whose X-Forwarded-For / X-Real-IP may be trusted for the real
# client IP (used by rate limiting). Comma/space separated CIDRs. Loopback by
# default (nginx runs on 127.0.0.1); set to the proxy address if different.
TRUSTED_PROXIES=127.0.0.1,::1
# Browser origins allowed by CORS, comma/space separated (defaults to the
# loopback frontend). Set the public frontend origin for non-localhost deploys.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# --- LoomOps (deny-by-default) ---
# Allow-listed executable basenames for ops_run_command (empty = deny all).
LOOMOPS_ALLOWED_COMMANDS=
# Roots ops_read_file/ops_write_file may touch (empty = deny all).
LOOMOPS_ALLOWED_PATHS=
# JSON-lines audit log (empty = plugins/LoomOps/tmp/loomops-audit.log in-container).
LOOMOPS_AUDIT_LOG=
LOOMOPS_COMMAND_TIMEOUT=30
# --- LoomOps host observability (read-only; host paths mounted under /host) ---
LOOMOPS_LOG_ROOTS=/host/var/log
LOOMOPS_MAX_LOG_LINES=200
LOOMOPS_CPU_THRESHOLD=80
LOOMOPS_DISK_THRESHOLD=90
LOOMOPS_LOAD_THRESHOLD=2.0
# Plugin enable/disable state file (empty = <plugins_dir>/../.loomcore/plugins.json).
PLUGINS_STATE_FILE=
# Plugin trust boundary: comma/space-separated plugin ids allowed to launch
# (empty = launch every discovered plugin). Plugins run unsandboxed as root.
LOOMCORE_PLUGINS_ALLOWED=
