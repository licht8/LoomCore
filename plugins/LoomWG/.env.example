# LoomWG plugin environment (consumed by the hub container).
# Copy the relevant lines into the project root .env (docker compose reads it).
# These are declared in plugins/LoomWG/manifest.json.

# Public endpoint host used in generated client configs.
# Auto-detected from the server when empty.
LOOMWG_ENDPOINT=

# WireGuard config directory inside the container (default /etc/wireguard).
LOOMWG_CONFIG_DIR=/etc/wireguard

# Set to 1 on firewalld hosts (RHEL/Rocky) to skip automatic firewall/NAT
# setup in wg_setup_server and configure it manually.
LOOMWG_SKIP_FIREWALL=0
